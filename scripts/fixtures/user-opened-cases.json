        "userOpened": 1,
        "machineOpened": 0,
        "unknownOrigin": 0,
        "userOpenedEligible": 1,
        "userOpenedDeclared": 1,
        "machineOpenedActing": 0,
        "batchUserNotFirst": 0,
        "midTurnUserOnly": 0,
        "eligible": 1,
        "eligibleDeclared": 1
      },
      "events": [
        {
          "type": "turn/start",
          "seq": 1,
          "data": {
            "turn": 1
          }
        },
        {
          "type": "user/message",
          "seq": 2,
          "data": {
            "id": "u1",
            "role": "user",
            "source": {
              "kind": "user"
            },
            "content": [
              {
                "type": "text",
                "text": "把这件事做了。"
              }
            ]
          }
        },
        {
          "type": "assistant/message",
          "seq": 3,
          "data": {
            "turn": 1,
            "step": 1,
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "text",
                  "text": "Intent: implementation — 写文件\n第二行不算门行。"
                }
              ]
            }
          }
        },
        {
          "type": "tool/call",
          "seq": 4,
          "data": {
            "turn": 1,
            "step": 1,
            "callId": "c1",
            "name": "write",
            "arguments": "{}"
          }
        }
      ]
